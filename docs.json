{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Greybeam",
  "description": "Run your Snowflake workloads on DuckDB with Greybeam.",
  "colors": {
    "primary": "#B4530A",
    "light": "#FA9F42",
    "dark": "#E8862A"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "dark": "#10100E",
      "light": "#FFFFFF"
    }
  },
  "fonts": {
    "heading": {
      "family": "TASA Orbiter",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/dark.svg",
    "dark": "/logo/light.svg",
    "href": "https://greybeam.ai"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "get-started/onboarding",
          "get-started/compute-endpoint",
          "quickstart"
        ]
      },
      {
        "group": "Greybeam platform",
        "pages": [
          "platform/overview",
          "platform/query-history",
          "platform/query-details",
          "platform/objects-explorer",
          "platform/hydration-jobs",
          "platform/analytics",
          "platform/query-blacklist",
          "platform/query-runner",
          "platform/dbt-projects",
          "platform/settings",
          "platform/account-settings"
        ]
      },
      {
        "group": "Connect",
        "pages": [
          "connect/dbt",
          "connect/bi-tools",
          "connect/drivers"
        ]
      },
      {
        "group": "How it works",
        "pages": [
          "how-it-works/query-routing",
          "how-it-works/hydration"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/routing-codes",
          "reference/sql-support",
          "reference/external-tables",
          "reference/limitations"
        ]
      },
      {
        "group": "Troubleshooting",
        "pages": [
          "troubleshooting/onboarding-verification"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open platform",
      "href": "https://demo.admin.greybeam.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://greybeam.ai"
    }
  }
}
